<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>ApartmentRental</display-name>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <session-config><session-timeout>30</session-timeout></session-config>

    <mime-mapping><extension>css</extension><mime-type>text/css;charset=UTF-8</mime-type></mime-mapping>
    <mime-mapping><extension>js</extension><mime-type>application/javascript;charset=UTF-8</mime-type></mime-mapping>
    <mime-mapping><extension>woff2</extension><mime-type>font/woff2</mime-type></mime-mapping>
    <mime-mapping><extension>woff</extension><mime-type>font/woff</mime-type></mime-mapping>
    <mime-mapping><extension>svg</extension><mime-type>image/svg+xml</mime-type></mime-mapping>

    <servlet-mapping><servlet-name>default</servlet-name><url-pattern>/css/*</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>default</servlet-name><url-pattern>/js/*</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>default</servlet-name><url-pattern>/images/*</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>default</servlet-name><url-pattern>/fonts/*</url-pattern></servlet-mapping>

    <!-- FILTERS -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.rental.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>EncodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.rental.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/user/*</url-pattern></filter-mapping>
    <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/admin/*</url-pattern></filter-mapping>

    <!-- SERVLETS -->
    <servlet><servlet-name>HomeServlet</servlet-name><servlet-class>com.rental.servlet.HomeServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>HomeServlet</servlet-name><url-pattern>/home</url-pattern></servlet-mapping>

    <servlet><servlet-name>AuthServlet</servlet-name><servlet-class>com.rental.servlet.AuthServlet</servlet-class></servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet><servlet-name>ApartmentServlet</servlet-name><servlet-class>com.rental.servlet.ApartmentServlet</servlet-class></servlet>
    <servlet-mapping>
        <servlet-name>ApartmentServlet</servlet-name>
        <url-pattern>/apartments</url-pattern>
        <url-pattern>/apartment/*</url-pattern>
        <url-pattern>/user/apartment/post</url-pattern>
        <url-pattern>/user/apartment/edit/*</url-pattern>
        <url-pattern>/user/apartment/delete/*</url-pattern>
    </servlet-mapping>

    <servlet><servlet-name>ContractServlet</servlet-name><servlet-class>com.rental.servlet.ContractServlet</servlet-class></servlet>
    <servlet-mapping>
        <servlet-name>ContractServlet</servlet-name>
        <url-pattern>/user/contracts</url-pattern>
        <url-pattern>/user/contract/*</url-pattern>
    </servlet-mapping>

    <!-- Payment — xử lý checkout, pending, success, history -->
    <servlet><servlet-name>PaymentServlet</servlet-name><servlet-class>com.rental.servlet.PaymentServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>PaymentServlet</servlet-name><url-pattern>/user/payment/*</url-pattern></servlet-mapping>

    <!-- API polling trạng thái thanh toán (AJAX gọi mỗi 3s) -->
    <servlet><servlet-name>PaymentStatusServlet</servlet-name><servlet-class>com.rental.servlet.PaymentStatusServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>PaymentStatusServlet</servlet-name><url-pattern>/api/payment/status</url-pattern></servlet-mapping>

    <!-- Webhook SePay — KHÔNG đặt sau AuthFilter, phải public -->
    <servlet><servlet-name>SepayWebhookServlet</servlet-name><servlet-class>com.rental.servlet.SepayWebhookServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>SepayWebhookServlet</servlet-name><url-pattern>/webhook/sepay</url-pattern></servlet-mapping>

    <servlet><servlet-name>ProfileServlet</servlet-name><servlet-class>com.rental.servlet.ProfileServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ProfileServlet</servlet-name><url-pattern>/user/profile</url-pattern></servlet-mapping>

    <servlet><servlet-name>NotificationServlet</servlet-name><servlet-class>com.rental.servlet.NotificationServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>NotificationServlet</servlet-name><url-pattern>/user/notifications</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminDashboardServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminDashboardServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminDashboardServlet</servlet-name><url-pattern>/admin/dashboard</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminApartmentServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminApartmentServlet</servlet-class></servlet>
    <servlet-mapping>
        <servlet-name>AdminApartmentServlet</servlet-name>
        <url-pattern>/admin/apartments</url-pattern>
        <url-pattern>/admin/apartment/*</url-pattern>
    </servlet-mapping>

    <servlet><servlet-name>AdminUserServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminUserServlet</servlet-class></servlet>
    <servlet-mapping>
        <servlet-name>AdminUserServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
        <url-pattern>/admin/user/*</url-pattern>
    </servlet-mapping>

    <servlet><servlet-name>AdminReportServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminReportServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminReportServlet</servlet-name><url-pattern>/admin/reports</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminExportServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminExportServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminExportServlet</servlet-name><url-pattern>/admin/export</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminETLServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminETLServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminETLServlet</servlet-name><url-pattern>/admin/etl</url-pattern></servlet-mapping>

    <servlet><servlet-name>ReviewServlet</servlet-name><servlet-class>com.rental.servlet.ReviewServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ReviewServlet</servlet-name><url-pattern>/review/*</url-pattern></servlet-mapping>

    <servlet><servlet-name>AdminReviewServlet</servlet-name><servlet-class>com.rental.servlet.admin.AdminReviewServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>AdminReviewServlet</servlet-name><url-pattern>/admin/reviews</url-pattern></servlet-mapping>
    <servlet-mapping><servlet-name>AdminReviewServlet</servlet-name><url-pattern>/admin/review/*</url-pattern></servlet-mapping>

    <servlet><servlet-name>ChatServlet</servlet-name><servlet-class>com.rental.servlet.ChatServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>ChatServlet</servlet-name><url-pattern>/api/chat</url-pattern></servlet-mapping>

    <servlet><servlet-name>FaqServlet</servlet-name><servlet-class>com.rental.servlet.FaqServlet</servlet-class></servlet>
    <servlet-mapping><servlet-name>FaqServlet</servlet-name><url-pattern>/faq</url-pattern></servlet-mapping>

    <error-page><error-code>404</error-code><location>/WEB-INF/views/error/404.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/WEB-INF/views/error/500.jsp</location></error-page>

    <listener><listener-class>com.rental.etl.core.ETLScheduler</listener-class></listener>

</web-app>
